{
  "name": "goodoffice",
  "version": "0.1.0",
  "private": true,
  "description": "GoodOffice — an offline-first desktop spreadsheet editor",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gekkehenkiee123/GoodOffice.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "install-electron",
    "format": "node tools/format-changed.mjs --write",
    "format:check": "node tools/format-changed.mjs --check",
    "check:theme-colors": "node tools/check-theme-colors.mjs",
    "check:docs-commands": "node tools/check-docs-commands.mjs",
    "check:inline-rules": "node tools/check-inline-rules.mjs",
    "check:page-cut-readers": "node tools/check-page-cut-readers.mjs",
    "check:table-layout-rules": "node tools/check-table-layout-rules.mjs",
    "check:font-rules": "node tools/check-font-rules.mjs",
    "check:font-metrics-provenance": "node tools/check-font-metrics-provenance.mjs",
    "check:generated-fonts": "node tools/check-generated-fonts.mjs",
    "check:word-truths": "node tools/truths-coverage.mjs --check",
    "check:english-comments": "node tools/check-english-comments.mjs",
    "check:skill-version": "node tools/check-skill-version.mjs",
    "check:help-langs": "node tools/check-help-langs.mjs",
    "lint": "eslint .",
    "fixtures": "npm run fixtures -w @genoffice/docx-engine",
    "test": "npm run test -w @genoffice/sheets",
    "typecheck": "npm run typecheck -w @genoffice/sheets",
    "predev": "node tools/build-stale-preloads.mjs",
    "dev": "npm run dev -w @genoffice/sheets",
    "dev:docs": "npm run dev -w @genoffice/docs",
    "build": "npm run build -w @genoffice/sheets",
    "build:all": "npm run build -w @genoffice/docs && npm run build -w @genoffice/sheets && npm run build -w @genoffice/slides && npm run build -w @genoffice/pdf && npm run build -w @genoffice/markdown && npm run build -w @genoffice/html && npm run build -w @genoffice/cli && npm run build -w @genoffice/shell",
    "shell": "npm run build:all && electron apps/shell",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "notices": "node tools/gen-third-party-notices.mjs",
    "licenses": "node tools/check-licenses.mjs",
    "dist:mac": "npm run notices && npm run build:all && npm run native:build:universal -w @genoffice/sheets && npm run dist:mac -w @genoffice/shell",
    "dist:win": "npm run notices && npm run build:all && npm run dist:win -w @genoffice/shell",
    "dist:linux": "npm run notices && npm run build:all && npm run dist:linux -w @genoffice/shell",
    "dev:goodoffice": "npm run dev -w @genoffice/sheets",
    "build:goodoffice": "npm run build -w @genoffice/sheets",
    "test:goodoffice": "npm run test -w @genoffice/sheets",
    "typecheck:goodoffice": "npm run typecheck -w @genoffice/sheets",
    "dist:goodoffice:mac": "npm run build -w @genoffice/sheets && npm run native:build:universal -w @genoffice/sheets && electron-builder --projectDir apps/sheets --config apps/sheets/electron-builder.goodoffice.cjs --mac"
  },
  "dependencies": {
    "ws": "^8.21.1"
  },
  "overrides": {
    "nanoid@3": "^3.3.17",
    "nanoid@5": "^5.1.16",
    "katex": "^0.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.61.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0"
  }
}
